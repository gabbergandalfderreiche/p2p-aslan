# "sepolia" = Base Sepolia testnet (default), "local" = local anvil node (see contracts/script/local.sh)
NEXT_PUBLIC_NETWORK=sepolia
# RPC of the local node, only used when NEXT_PUBLIC_NETWORK=local
NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545
# Free project ID from dashboard.reown.com; enables the "sign in with your phone" QR code
NEXT_PUBLIC_WC_PROJECT_ID=
# Base Builder Code from dashboard.base.org (ERC-8021 attribution, needed for Base grants)
NEXT_PUBLIC_BASE_BUILDER_CODE=
